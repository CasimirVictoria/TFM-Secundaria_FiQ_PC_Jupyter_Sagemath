  url = {https://scratched.gse.harvard.edu/ct/files/AERA2012.pdf},
  abstract = {In recent years, there has been a resurgence of interest in computational thinking, which describes the concepts, practices, and perspectives that learners develop as they engage with computer science and programming. In this paper, we propose a framework for studying and assessing computational thinking across three dimensions: computational concepts (the concepts designers engage with as they program, such as sequence, loops, events, conditionals, and operators), computational practices (the practices designers develop as they engage with the concepts, such as experimenting and iterating, testing and debugging, and modularizing), and computational perspectives (the perspectives designers form about the world around them and about themselves, such as expressing, connecting, and questioning).},
  file = {/home/casimir/Documents/Segon_Cervell/TFM/PDFs/Emprar/2. TFM - Recerca Didàctica i Pensament Computacional/Brennan_Resnick_2012_New_Frameworks_Assessing_Computational_Thinking.pdf}
