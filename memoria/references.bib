@article{Furio_2001,
  author    = {Furi{\'o}-M{\'a}s, Carles and Vilches, Amparo and Guisasola, Jenaro and Romo, Ver{\'o}nica},
  title     = {Finalidades de la ense{\~n}anza de las ciencias en la secundaria obligatoria. {¿Alfabetizaci{\'o}n cient{\'i}fica o preparaci{\'o}n propedéutica?}},
  journal   = {Ense{\~n}anza de las Ciencias},
  volume    = {19},
  number    = {3},
  pages     = {365--376},
  year      = {2001},
  url       = {https://raco.cat/index.php/Ensenanza/article/view/21756},
  abstract  = {Esta investigación indaga las opiniones del profesorado de secundaria sobre las finalidades y objetivos de la enseñanza de las ciencias en el marco de las reformas curriculares. Mediante un diseño experimental múltiple y convergente con muestras de profesores de física y química, se constata que el pensamiento docente prioriza mayoritariamente la preparación propedéutica del alumnado (dominio de conceptos, leyes y teorías para superar cursos posteriores) sobre la alfabetización científica orientada a la ciudadanía. Este énfasis propedéutico explica la persistencia de un modelo de enseñanza transmissivo centrado en contenidos formales, en detrimento de la contextualización sociocientífica, las relaciones CTSA y el desarrollo de competencias críticas. Los resultados ponen de manifiesto la distancia cognitiva entre las intenciones curriculares reformistas —orientadas a una ciencia para todos— y las finalidades reales que el profesorado atribuye a su práctica docente.},
  file      = {/home/casimir/Documents/Segon_Cervell/TFM/PDFs/Emprar/2. TFM - Recerca Didàctica i Pensament Computacional/Furio_2001_Finalidades_Ensenanza_Ciencias_Alfabetizacion.pdf}
}

@techreport{Rocard_2007,
  author       = {Rocard, Michel and Csermely, Peter and Jorde, Doris and Lenzen, Dieter and Wallberg-Henriksson, Harriet and Hemmo, Val{\'e}rie},
  title        = {Science Education NOW: A Renewed Pedagogy for the Future of Europe},
  institution  = {European Commission, Directorate-General for Research, Science, Economy and Society},
  year         = {2007},
  number       = {EUR 22845},
  type         = {Report of the High Level Group on Science Education},
  address      = {Luxembourg},
  publisher    = {Office for Official Publications of the European Communities},
  isbn         = {978-92-79-05659-8},
  url          = {https://op.europa.eu/en/publication-detail/-/publication/ea9c9e24-e3f0-40c8-abba-fd3fed9d4b3e},
  abstract     = {This report by an expert group chaired by Michel Rocard, Member of the European Parliament and former Prime Minister of France, examines the alarming decline in young people's interest in science studies and mathematics across Europe. The group identifies the predominance of deductive, transmissive teaching methods — where knowledge is presented ready-made from teacher to student — as the primary cause of disengagement with science. The report advocates a paradigm shift towards inquiry-based science education (IBSE), in which students are engaged in real investigations, develop their own questions, and construct knowledge actively. It draws on evidence from over 30 pan-European initiatives and projects, demonstrating that inquiry-based approaches systematically increase student motivation, curiosity and performance in science. The report makes four main recommendations: (1) priority support for inquiry-based teaching across all school levels; (2) coordination of teacher training in IBSE methods; (3) strengthening partnerships between schools, universities, scientific centres and industry; and (4) European-level exchange and dissemination of best practice in science pedagogy.},
  file         = {/home/casimir/Documents/Segon_Cervell/TFM/PDFs/Emprar/2. TFM - Recerca Didàctica i Pensament Computacional/Rocard_2007_Science_Education_Now_Pedagogy_Europe.pdf}
}

